# Dannig Optica - local development example
#
# Copy this file to .env for local reference.
# Important: the backend does not load .env automatically today. Export these
# variables in your terminal, or use docker-compose, before running the backend.

# Backend runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
# Prisma is currently configured for MySQL. Do not change the provider yet.
DATABASE_URL=mysql://dannig:dannig@localhost:3307/dannig

# Auth
# Use a long local secret. In production it must be at least 32 characters.
JWT_SECRET=local-development-secret-change-me-32-chars

# CORS / frontend URL
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:3001

# Optional seed/demo users
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@dannig.local
ADMIN_PASSWORD=admin123
CAPTADOR_NAME=Captador
CAPTADOR_EMAIL=captador@dannig.local
CAPTADOR_PASSWORD=captador123
OFTALMOLOGO_NAME=Dr. Oftalmologo
OFTALMOLOGO_EMAIL=oftalmologo@dannig.local
OFTALMOLOGO_PASSWORD=oftalmologo123
DEFAULT_PASSWORD=dannig123

# Optional notifications. Uncomment and fill only when needed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=notificaciones@example.com
# SMS_PROVIDER=twilio
# SMS_API_KEY=change-me
# TWILIO_ACCOUNT_SID=change-me
# TWILIO_AUTH_TOKEN=change-me
# TWILIO_PHONE_NUMBER=+56900000000

# Optional deployment/startup toggles used by Railway scripts.
SEED_DATABASE=false
FORCE_SEED=false
